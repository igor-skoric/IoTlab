# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1:8000,http://localhost:8000
DJANGO_SETTINGS_MODULE=iot_lab.settings.development

# Database used by the Django app.
# docker compose: use the db service hostname.
DATABASE_URL=postgres://iot_lab:iot_lab@db:5432/iot_lab

# Postgres container (docker compose)
POSTGRES_DB=iot_lab
POSTGRES_USER=iot_lab
POSTGRES_PASSWORD=iot_lab
POSTGRES_PORT=5432

# Optional: override Django timezone (default UTC)
# TIME_ZONE=Europe/Ljubljana
